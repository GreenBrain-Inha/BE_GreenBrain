# Common
APP_ENV=local
DB_URL=
JWT_SECRET_KEY=
OPENAI_API_KEY=
RUNYOUR_API_KEY=
ALLOWED_ORIGINS=

# Optional: file storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/uploads
LOCAL_STORAGE_BASE_URL=/uploads

# Optional: Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=greenbrain-uploads
# Do not include the bucket name here. URLs are built as:
# {SUPABASE_STORAGE_PUBLIC_BASE_URL}/{SUPABASE_STORAGE_BUCKET}/{key}
SUPABASE_STORAGE_PUBLIC_BASE_URL=
