# Common
APP_ENV=local
DB_URL=
JWT_SECRET_KEY=
OPENAI_API_KEY=
RUNYOUR_API_KEY=
ALLOWED_ORIGINS=

# Optional: file storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/uploads
LOCAL_STORAGE_BASE_URL=/uploads

# Optional: Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=greenbrain-uploads
# Bucket may be omitted or included. Both forms are supported:
# https://<project-ref>.supabase.co/storage/v1/object/public
# https://<project-ref>.supabase.co/storage/v1/object/public/greenbrain-uploads
SUPABASE_STORAGE_PUBLIC_BASE_URL=
